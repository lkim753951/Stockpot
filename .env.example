# Leave MODEL_API_KEY empty to run the sample flow with no key and no cost.
# scripts/test-ai-ingest.ts uses this key too, and needs it set here.
MODEL_API_KEY=

# Required as soon as a real key is used on a public address.
OWNER_PASSCODE=
STAFF_PASSCODE=
SESSION_SECRET=

# Leave all of these empty to run on SQLite and local files, which is right for a Mac.
# The pooled connection string from Supabase, on port 6543. Set this and data lives in Postgres.
DATABASE_URL=
# Which schema to use. Leave empty for public. The sample site must use sample.
DB_SCHEMA=
# Set both of these and files live in a private Storage bucket.
SUPABASE_URL=
# Keep this secret. It can read and change everything in the project. It stays on the server.
SUPABASE_SERVICE_KEY=
# The bucket. Leave empty for stockpot. Give the sample site its own.
SUPABASE_BUCKET=
# Any long random text. /api/cron refuses every request without it.
CRON_SECRET=
# The other site's address. The first screen links to it: the real app from the sample, and the sample from the real app.
OTHER_SITE_URL=

# Gmail. Add these on the Connections screen, or here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Phone calls for late checklists. Leave empty to chase on WhatsApp only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# The phone that rings for the owner. Leave empty to use WHATSAPP_OWNER_NUMBER.
OWNER_PHONE=

# WhatsApp Cloud API. Leave empty and the app simulates messages in sample mode.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OWNER_NUMBER=
# The number staff message. Invite links use it. Leave empty and Stockpot asks Meta for it.
WHATSAPP_BUSINESS_NUMBER=
# Staff as Name:number or Name:number:language (pl, ro, es, ko), with commas between people. Empty sends checklists to the owner's phone.
WHATSAPP_STAFF_NUMBERS=
# Replies. The app secret proves a message came from Meta. The verify token is any long random text.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# An approved Meta template with one body value, so Stockpot can message someone first. Leave empty to use free-form text only.
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en
WEBHOOK_PORT=8788

PORT=8787
RESTAURANT_TIMEZONE=Europe/London
DATA_DIR=./data

# Stops a runaway bill. Counts every Muse Spark and file transcription call since the server started.
# On Vercel each instance keeps its own count.
MAX_MODEL_CALLS=2000

# Rarely needed. A relay in a region Meta accepts, if Meta refuses every Vercel region.
# META_BASE_URL=
# Rarely needed. Connections to Postgres per instance, default 3.
# DB_POOL_MAX=3
# Rarely needed. The CA certificate as text, to check the database's certificate as well as encrypt the connection.
# DATABASE_CA=
