{
  "name": "stockpot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Stockpot hears the price, watches the delivery, reads the invoice and gets restaurants their money back, built on Meta models.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "test": "node --import tsx --test --test-concurrency=1 --test-timeout=120000 --test-force-exit test/money.test.ts test/flow.test.ts test/features.test.ts test/team.test.ts test/setup.test.ts test/database.test.ts test/storage.test.ts test/hosting.test.ts test/vercel.test.ts test/ingest.test.ts test/words.test.ts",
    "typecheck": "tsc --noEmit",
    "samples": "python3 scripts/make_samples.py",
    "datasets": "python3 scripts/make_datasets.py",
    "check:meta": "tsx scripts/check-meta.ts",
    "test:postgres": "tsx scripts/test-postgres.ts"
  },
  "dependencies": {
    "@copilotkit/react-core": "^1.83.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vercel/functions": "^3.10.6",
    "ajv": "^8.20.0",
    "express": "^5.3.0",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.13.0",
    "multer": "^2.5.0",
    "ogg-opus-decoder": "^1.7.5",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "read-excel-file": "^9.3.12",
    "tsx": "^4.23.15",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.2.0",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
